<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.usc.elvis.controller.PrincipalController"
            styleClass="fondo-app">
    <top>
        <HBox styleClass="barra-navegacion" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>
            <Text text="&#128737;" styleClass="icono-logo"/>
            <Text text="SERVIDOR ELVIS" styleClass="titulo-logo"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="botonInicio" text="Inicio" onAction="#mostrarInicio"
                    styleClass="boton-nav, boton-nav-activo"/>
            <Button fx:id="botonCuentas" text="Administrar Cuentas" onAction="#mostrarAdministrarCuentas"
                    styleClass="boton-nav"/>
            <Button fx:id="botonCalendario" text="Calendario" onAction="#mostrarCalendario"
                    styleClass="boton-nav"/>
            <Button fx:id="botonReportes" text="Reportes" onAction="#mostrarReportes"
                    styleClass="boton-nav"/>
            <Button fx:id="botonUsuarios" text="Usuarios" onAction="#mostrarUsuarios"
                    styleClass="boton-nav"/>

            <MenuButton fx:id="menuPerfil" styleClass="boton-perfil" popupSide="BOTTOM">
                <graphic>
                    <HBox spacing="9" alignment="CENTER_LEFT">
                        <Label fx:id="avatarPerfil" styleClass="avatar"/>
                        <VBox alignment="CENTER_LEFT" spacing="0">
                            <Label fx:id="etiquetaNombrePerfil" styleClass="perfil-nombre"/>
                            <Label fx:id="etiquetaRolPerfil" styleClass="perfil-rol"/>
                        </VBox>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem fx:id="itemPerfilDatos" disable="true" styleClass="item-encabezado"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="itemCerrarSesion" text="Cerrar sesión" onAction="#cerrarSesion"
                              styleClass="item-cerrar-sesion"/>
                </items>
            </MenuButton>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contenedorVistas" styleClass="contenedor-vistas"/>
    </center>
</BorderPane>