<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.usc.elvis.controller.AdministrarCuentasController"
            fitToWidth="true" styleClass="vista-administrar">
    <content>
        <HBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="560">
                <TitledPane fx:id="panelRegistrarCurso" text="1. Registrar Nuevo Curso / Materia"
                            expanded="false" styleClass="panel-colapsable">
                    <content>
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" bottom="4"/>
                            </padding>

                            <Label text="Nombre de la Materia / Asignatura" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoNombreMateria" promptText="Ej. Sistemas Distribuidos A-1"/>

                            <Label text="Código del Curso" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoCodigoCurso" promptText="Ej. ING-SIS-604"/>

                            <Label text="Semestre Lectivo" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoSemestre" promptText="Ej. 2024-B"/>

                            <Label text="Docente Responsable" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoDocente" promptText="Ej. Ing. Carlos H. Vivas"/>

                            <Label text="Día de Clase" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboDia" promptText="Seleccionar día..." maxWidth="Infinity"/>

                            <Label text="Horario / Franja" styleClass="etiqueta-campo"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ComboBox fx:id="comboHoraInicio" promptText="Hora inicio" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label text="a"/>
                                <ComboBox fx:id="comboHoraFin" promptText="Hora fin" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>

                            <Label text="Cantidad de Licencias Requeridas" styleClass="etiqueta-campo"/>
                            <Spinner fx:id="spinnerLicencias" editable="true"/>

                            <Label fx:id="etiquetaDuenoCurso" text="Dueño del curso (usuario que lo administra)"
                                   styleClass="etiqueta-campo" managed="false" visible="false"/>
                            <ComboBox fx:id="comboDuenoCurso" promptText="Selecciona un usuario..."
                                      maxWidth="Infinity" managed="false" visible="false"/>

                            <Button fx:id="botonCrearCurso" text="Crear y Registrar Curso" onAction="#registrarCurso"
                                    styleClass="boton-primario" maxWidth="Infinity"/>
                            <Label fx:id="etiquetaEstado" wrapText="true" styleClass="etiqueta-mensaje"/>

                            <Label text="Cursos Registrados" styleClass="etiqueta-campo"/>
                            <TableView fx:id="tablaCursos" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colCursoCodigo" text="Código" prefWidth="70"/>
                                    <TableColumn fx:id="colCursoNombre" text="Materia" prefWidth="115"/>
                                    <TableColumn fx:id="colCursoDocente" text="Docente" prefWidth="100"/>
                                    <TableColumn fx:id="colCursoDueno" text="Dueño" prefWidth="95"/>
                                    <TableColumn fx:id="colCursoAcciones" text="Acciones" prefWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane fx:id="panelCargaListas" text="2. Carga de Listas (.xlsx)"
                            expanded="false" styleClass="panel-colapsable">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" bottom="4"/>
                            </padding>

                            <Label text="Curso Destino para la Lista" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboCursoDestino" promptText="Selecciona un curso..." maxWidth="Infinity"/>

                            <Button fx:id="botonSeleccionarArchivoEstudiantes" text="Seleccionar Archivo Excel"
                                    onAction="#seleccionarArchivoEstudiantes" styleClass="boton-secundario" maxWidth="Infinity"/>
                            <Label fx:id="etiquetaArchivoEstudiantes" text="Ningún archivo seleccionado"
                                   styleClass="texto-placeholder-panel"/>

                            <Label fx:id="etiquetaResumenPreview" wrapText="true" styleClass="etiqueta-mensaje"/>
                            <TableView fx:id="tablaPreviewEstudiantes" prefHeight="160">
                                <columns>
                                    <TableColumn fx:id="colNombre" text="Nombre Estudiante" prefWidth="180"/>
                                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                                    <TableColumn fx:id="colCorreo" text="Correo Institucional" prefWidth="200"/>
                                </columns>
                            </TableView>

                            <Button fx:id="botonValidarYProcesar" text="Validar y Procesar Lista"
                                    onAction="#procesarListaEstudiantes" styleClass="boton-primario" maxWidth="Infinity" disable="true"/>
                            <Label fx:id="etiquetaResultadoEstudiantes" wrapText="true" styleClass="etiqueta-mensaje"/>

                            <Label text="Estudiantes Registrados en este Curso" styleClass="etiqueta-campo"/>
                            <TableView fx:id="tablaEstudiantesCurso" prefHeight="160">
                                <columns>
                                    <TableColumn fx:id="colEstNombre" text="Nombre" prefWidth="180"/>
                                    <TableColumn fx:id="colEstCodigo" text="Código" prefWidth="90"/>
                                    <TableColumn fx:id="colEstAcciones" text="Acciones" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </TitledPane>
            </VBox>

            <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="560">
                <TitledPane fx:id="panelCargarLicencias" text="0. Cargar / Actualizar Licencias"
                            expanded="false" styleClass="panel-colapsable">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" bottom="4"/>
                            </padding>
                            <Label fx:id="etiquetaAvisoRol" wrapText="true" styleClass="aviso-info"
                                   text="Solo el administrador puede cargar, modificar o eliminar licencias. Aquí puedes consultarlas."
                                   managed="false" visible="false"/>
                            <Label fx:id="etiquetaEstadoLicencias" wrapText="true" styleClass="resumen-estado"/>
                            <Label text="Sube un Excel (.xlsx) con las columnas: Usuario | Contraseña | IP. Si el usuario ya existe, se actualiza; si no, se crea."
                                   styleClass="texto-descripcion" wrapText="true"/>
                            <Button fx:id="botonSeleccionarArchivoLicencias" text="Seleccionar Archivo Excel"
                                    onAction="#seleccionarArchivoLicencias" styleClass="boton-secundario" maxWidth="Infinity"/>
                            <Label fx:id="etiquetaArchivoLicencias" text="Ningún archivo seleccionado"
                                   styleClass="texto-placeholder-panel"/>
                            <Button fx:id="botonCargarLicencias" text="Cargar y Actualizar Licencias"
                                    onAction="#cargarLicencias" styleClass="boton-primario" maxWidth="Infinity" disable="true"/>
                            <Label fx:id="etiquetaResultadoLicencias" wrapText="true" styleClass="etiqueta-mensaje"/>

                            <Label text="Licencias Registradas" styleClass="etiqueta-campo"/>
                            <TableView fx:id="tablaLicencias" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colLicUsuario" text="Usuario" prefWidth="130"/>
                                    <TableColumn fx:id="colLicIp" text="IP" prefWidth="100"/>
                                    <TableColumn fx:id="colLicEstado" text="Estado" prefWidth="80"/>
                                    <TableColumn fx:id="colLicAcciones" text="Acciones" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </TitledPane>

                <VBox styleClass="tarjeta-panel" spacing="10">
                    <Text text="3. Asignación y Reparto de Licencias de Acceso" styleClass="titulo-panel"/>

                    <Label text="Curso a Asignar" styleClass="etiqueta-campo"/>
                    <ComboBox fx:id="comboCursoAsignar" promptText="Selecciona un curso..." maxWidth="Infinity"/>
                    <Label fx:id="etiquetaInfoCursoAsignar" wrapText="true" styleClass="texto-descripcion"/>

                    <Button fx:id="botonAsignarLicencias" text="Asignar Licencias" onAction="#asignarLicenciasCurso"
                            styleClass="boton-primario" maxWidth="Infinity"/>
                    <Label fx:id="etiquetaResultadoAsignacion" wrapText="true" styleClass="etiqueta-mensaje"/>

                    <Label text="Asignaciones Activas" styleClass="etiqueta-campo"/>
                    <TableView fx:id="tablaAsignaciones" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colAsigCurso" text="Curso" prefWidth="110"/>
                            <TableColumn fx:id="colAsigEstudiante" text="Estudiante" prefWidth="140"/>
                            <TableColumn fx:id="colAsigLicencia" text="Licencia" prefWidth="110"/>
                            <TableColumn fx:id="colAsigHorario" text="Horario" prefWidth="150"/>
                            <TableColumn fx:id="colAsigEstadoEnvio" text="Envío" prefWidth="80"/>
                            <TableColumn fx:id="colAsigAcciones" text="Acciones" prefWidth="140"/>
                        </columns>
                    </TableView>

                    <Button fx:id="botonConfirmarYEnviar" text="Confirmar y Enviar Correos Pendientes"
                            onAction="#confirmarYEnviarNotificaciones" styleClass="boton-primario" maxWidth="Infinity"/>
                    <Label fx:id="etiquetaResultadoEnvio" wrapText="true" styleClass="etiqueta-mensaje"/>
                </VBox>
            </VBox>
        </HBox>
    </content>
</ScrollPane>