<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.usc.elvis.controller.LoginController"
      alignment="CENTER" spacing="14" styleClass="vista-inicio">
    <padding>
        <Insets top="50" bottom="50" left="40" right="40"/>
    </padding>
    <Text text="🛡" styleClass="icono-grande"/>
    <Text text="SERVIDOR ELVIS" styleClass="titulo-principal"/>
    <Text text="Iniciar Sesión" styleClass="titulo-secundario"/>

    <TextField fx:id="campoUsuario" promptText="Usuario" maxWidth="260"/>
    <PasswordField fx:id="campoContrasena" promptText="Contraseña" maxWidth="260"/>
    <Button text="Ingresar" onAction="#iniciarSesion" styleClass="boton-primario" maxWidth="260"/>
    <Label fx:id="etiquetaError" styleClass="mensaje-error" wrapText="true" maxWidth="260"/>
</VBox>